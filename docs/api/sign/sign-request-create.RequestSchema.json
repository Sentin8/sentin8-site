{"title":"Body","body":{"content":{"application/json":{"schema":{"type":"object","description":"Request body for creating a signature request.","required":["title","documents","signers"],"properties":{"documents":{"type":"array","items":{"type":"object","description":"A document reference - storage ref only, never inline bytes.","required":["ref","name","hash"],"properties":{"hash":{"type":"string","description":"Content hash (what the signature covers)."},"name":{"type":"string","description":"Display name."},"ref":{"type":"string","description":"Storage object reference."}},"title":"DocumentRef"},"description":"Document set: storage refs + display names + content hashes."},"expires_at":{"type":["string","null"],"format":"date-time","description":"Optional expiry; the sweep closes stale opens."},"idempotency_key":{"type":["string","null"],"description":"Optional client idempotency key (dedupes create)."},"signature_level":{"type":"string","description":"Requested signature level."},"signers":{"type":"array","items":{"type":"string"},"description":"Signer set (fixed after creation)."},"title":{"type":"string","description":"Human title of the request."}},"title":"CreateRequest"}}},"required":true}}