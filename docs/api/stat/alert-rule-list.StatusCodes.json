{"responses":{"200":{"description":"Rules for the property","content":{"application/json":{"schema":{"type":"array","items":{"type":"object","description":"A per-property custom alert rule (`stat.alert_rules`, stat README §7).\nThe alertrule type.","required":["id","env_id","property_id","name","rule_type","metric_name","comparator","threshold","window_hours","min_sample","enabled","created_at","updated_at"],"properties":{"comparator":{"type":"string","description":"Comparator - `gt` | `gte` | `lt` | `lte`."},"created_at":{"type":"string","format":"date-time","description":"created time."},"enabled":{"type":"boolean","description":"Whether the rule evaluates."},"env_id":{"type":"string","format":"uuid","description":"env identifier."},"id":{"type":"string","format":"uuid","description":"Identifier."},"metric_name":{"type":"string","description":"Metric vocabulary key (`events.count`, `conversions.count`,\n`metric:{name}`)."},"min_sample":{"type":"integer","format":"int32","description":"Noise floor - the rule never evaluates below it."},"name":{"type":"string","description":"Display name."},"property_id":{"type":"string","format":"uuid","description":"Watched property identifier."},"rule_type":{"type":"string","description":"Rule type - `threshold` (metric value vs threshold) or `anomaly`\n(moving-average deviation factor over the window)."},"threshold":{"type":"number","format":"double","description":"Comparison threshold (metric value or deviation factor)."},"updated_at":{"type":"string","format":"date-time","description":"updated time."},"window_hours":{"type":"integer","format":"int32","description":"Moving-average lookback in hours (`anomaly` rules)."}},"title":"AlertRule"}}}}},"403":{"description":"Missing stat:admin scope"}}}