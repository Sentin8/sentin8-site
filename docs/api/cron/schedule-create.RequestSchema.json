{"title":"Body","body":{"content":{"application/json":{"schema":{"type":"object","description":"Request body for createschedule.","required":["domain","schedule_type","cron_expression"],"properties":{"cron_expression":{"type":"string","description":"The cron expression."},"domain":{"type":"string","description":"The domain."},"fire_at":{"type":["string","null"],"format":"date-time","description":"Single fire time for `kind: \"once\"` schedules (RFC 3339)."},"kind":{"type":["string","null"],"description":"`once` = single fire at `fire_at` (then `completed`); default\nrecurring = the cron expression drives every fire."},"max_retries":{"type":"integer","format":"int32","description":"Maximum retries."},"schedule_type":{"type":"string","description":"The schedule type."},"target_config":{"description":"The target config."},"timezone":{"type":["string","null"],"description":"IANA zone the cron_expression's wall-clock fields match against\n(CRON-6, cron README §7). Default 'UTC'. Rejected at create time\nwhen unparseable."}},"title":"CreateScheduleRequest"}}},"required":true}}