  "components": {
    "schemas": {
      "AlterTableRequest": {
        "type": "object",
        "description": "`POST /v1/tables/{id}/alter` - safe schema alteration (ADD COLUMN only).\nEnv-scoped; audited + event emitted in the same transaction.\nRequest body for altertable.",
        "required": [
          "add_columns"
        ],
        "properties": {
          "add_columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ColumnDef"
            },
            "description": "The add columns."
          }
        }
      },
      "ColumnDef": {
        "type": "object",
        "description": "One column definition of a created table.",
        "required": [
          "name",
          "data_type",
          "nullable"
        ],
        "properties": {
          "data_type": {
            "type": "string",
            "description": "Logical data type."
          },
          "default": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional SQL default expression."
          },
          "name": {
            "type": "string",
            "description": "Column name."
          },
          "nullable": {
            "type": "boolean",
            "description": "Whether nulls are allowed."
          }
        }
      },
      "CreateTableRequest": {
        "type": "object",
        "description": "Request body for createtable.",
        "required": [
          "table_name",
          "display_name"
        ],
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ColumnDef"
            },
            "description": "The columns."
          },
          "display_name": {
            "type": "string",
            "description": "The display name."
          },
          "table_name": {
            "type": "string",
            "description": "The table name."
          }
        }
      },
      "DeleteRequest": {
        "type": "object",
        "description": "`POST /v1/data/delete` - soft-delete rows by filter (`deleted_at = now`).\nNo hard-delete fallback: physical removal happens only via the controlled\ndrop flow.\nRequest body for delete.",
        "required": [
          "table"
        ],
        "properties": {
          "filter": {
            "description": "The filter."
          },
          "table": {
            "type": "string",
            "description": "The table."
          }
        }
      },
      "InsertRequest": {
        "type": "object",
        "description": "Request body for insert.",
        "required": [
          "table",
          "rows"
        ],
        "properties": {
          "rows": {
            "type": "array",
            "items": {},
            "description": "The rows."
          },
          "table": {
            "type": "string",
            "description": "The table."
          }
        }
      },
      "Pagination": {
        "type": "object",
        "description": "Limit/offset pagination window.",
        "properties": {
          "after": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Keyset cursor (DB-3, db README §7): return rows strictly after this\n`id`. Takes precedence over `offset` when set - stable under inserts\nbetween pages, unlike the offset window. Paired with `sort` on `id`\nenforced server-side when the cursor is used."
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Maximum rows to return.",
            "minimum": 0
          },
          "offset": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Rows to skip (offset mode).",
            "minimum": 0
          }
        }
      },
      "QueryRequest": {
        "type": "object",
        "description": "Request body for `POST /v1/data/query`.",
        "required": [
          "table"
        ],
        "properties": {
          "filters": {
            "description": "Opaque filter expression (the server interprets per table)."
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination",
            "description": "Limit/offset window."
          },
          "sort": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SortClause"
            },
            "description": "Sort clauses in priority order."
          },
          "table": {
            "type": "string",
            "description": "The table to query."
          }
        }
      },
      "QueryResponse": {
        "type": "object",
        "description": "Response from `POST /v1/data/query`.",
        "required": [
          "rows",
          "total"
        ],
        "properties": {
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Keyset cursor (DB-3): the last returned row's `id` - pass it back as\n`pagination.after` to fetch the next page. `null` when the page was\nthe last (fewer rows than `limit` returned)."
          },
          "rows": {
            "type": "array",
            "items": {},
            "description": "The matched rows as JSON objects."
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Total matching row count (ignoring pagination).",
            "minimum": 0
          }
        }
      },
      "SortClause": {
        "type": "object",
        "description": "One sort instruction.",
        "required": [
          "column"
        ],
        "properties": {
          "column": {
            "type": "string",
            "description": "Column to sort by."
          },
          "descending": {
            "type": "boolean",
            "description": "Sort descending when true (default ascending)."
          }
        }
      },
      "TableResponse": {
        "type": "object",
        "description": "Response payload for table.",
        "required": [
          "id",
          "table_name",
          "display_name",
          "status"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "description": "The display name."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier."
          },
          "status": {
            "type": "string",
            "description": "The status."
          },
          "table_name": {
            "type": "string",
            "description": "The table name."
          }
        }
      },
      "TargetEnvQuery": {
        "type": "object",
        "description": "Query parameter for cross-env operations - allows callers (e.g. BFF) to\ntarget a specific env. Only honored when the caller carries platform-admin\nauthority (`sentin8:sys:admin`) or targets their own env.\nThe targetenvquery type.",
        "properties": {
          "target_env_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "target env identifier."
          }
        }
      },
      "UpdateRequest": {
        "type": "object",
        "description": "`POST /v1/data/update` - update rows by filter with resource version check.\nRequest body for update.",
        "required": [
          "table",
          "set"
        ],
        "properties": {
          "filter": {
            "description": "The filter."
          },
          "resource_version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "The resource version."
          },
          "set": {
            "description": "The set."
          },
          "table": {
            "type": "string",
            "description": "The table."
          }
        }
      }
    }
  },
  "security": [],
  "tags": [
    {
      "name": "policy",
      "description": "Shield policy administration (shared surface)"
    },
    {
      "name": "db",
      "description": "Sentin8:DB admin API - tables, data CRUD, posture, audit"
    }
  ]
}
