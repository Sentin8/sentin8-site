    "/v1/client-cert": {
      "post": {
        "tags": [
          "acme"
        ],
        "summary": "`POST /v1/client-cert`",
        "description": "GUARDED: the caller must present a Sentin8:Auth token verifying against\nthe platform JWKS, and its `sub` must equal the requested `service_name`\n- a workload can only mint a certificate for its own registered name.\n\nThe response (combined PEM: leaf chain + private key) is returned **once**\n- the key is not persisted server-side; the caller persists it in its own\ncredential cache. The certificate is recorded in Acme's cert store so the\nadmin UI can list/revoke it.\n\nmint an mTLS client certificate.",
        "operationId": "client_cert.issue",
        "responses": {
          "200": {
            "description": "Combined PEM (leaf chain + key)",
            "content": {
              "application/x-pem-file": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "invalid service_name"
          },
          "401": {
            "description": "missing/invalid bearer token"
          },
          "403": {
            "description": "sub does not match the requested service_name"
          }
        },
        "security": [
          {
            "sentin8:acme:clientcert:issue": []
          }
        ]
      }
    },
