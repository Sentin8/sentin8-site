{
  "openapi": "3.1.0",
  "info": {
    "title": "sentin8-acme",
    "description": "Sentin8 Sentin8:Acme - internal ACME certificate authority server.",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/.well-known/acme-challenge/{token}": {
      "get": {
        "tags": [
          "acme"
        ],
        "summary": "`GET /.well-known/acme-challenge/{token}`",
        "operationId": "serve_challenge_token",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "description": "Challenge token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The key authorization (application/jose+json, upstream orders)"
          },
          "404": {
            "description": "Unknown token / local order"
          }
        },
        "security": [],
        "description": "Serve an http-01 key authorization for the upstream CA's validator\n(DESIGN §4.3): `GET /.well-known/acme-challenge/{token}`. The proxy's\n:80 listener forwards here; the bounded map holds only tokens captured\nfor in-flight external orders. Unauthenticated by design (RFC 8555\n§8.1) - the token itself is the capability."
      }
    },
    "/acme/authz/{id}": {
      "get": {
        "tags": [
          "acme"
        ],
        "summary": "`GET /acme/authz/{id}`",
        "operationId": "get_authz",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Authorization id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorization challenges (RFC 8555 §7.1.4)"
          },
          "404": {
            "description": "Unknown authorization"
          }
        },
        "security": [],
        "description": "fetch an authorization (RFC 8555 §7.1.4)."
      }
    },
    "/acme/cert/{id}": {
      "get": {
        "tags": [
          "acme"
        ],
        "summary": "`GET /acme/cert/{id}`",
        "operationId": "get_cert",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Certificate cache id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Certificate (chain; + private key for locally-issued certs)"
          },
          "404": {
            "description": "Unknown certificate"
          }
        },
        "security": [],
        "description": "download the certificate as a combined PEM\n(chain, plus the private key for locally-issued certs so TLS can build\nits `ServerConfig` from one artifact)."
      }
    },
    "/acme/challenge/{id}": {
      "post": {
        "tags": [
          "acme"
        ],
        "summary": "`POST /acme/challenge/{id}`",
        "operationId": "challenge_ready",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Challenge id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Challenge marked ready (proxy mode: notifies the upstream)"
          },
          "404": {
            "description": "Unknown challenge"
          },
          "409": {
            "description": "Challenge not pending"
          }
        },
        "security": [],
        "description": "signal the challenge is ready for\nvalidation (RFC 8555 §8.3). Local orders short-circuit to `valid`\n(the challenge target is the platform's own host network); external\norders notify the upstream CA that its http-01 challenge is ready -\nthe upstream then fetches the key authorization from the proxy's\n:80 listener → acme's well-known route (DESIGN §4.2/§4.3)."
      }
    },
    "/acme/directory": {
      "get": {
        "tags": [
          "acme"
        ],
        "summary": "`GET /acme/directory`",
        "description": "URLs are derived from the incoming request's scheme and Host header so\nthey remain correct on any port or replica (auto-scale friendly).\n\nACME directory object (RFC 8555 §7.1.1).",
        "operationId": "directory_handler",
        "responses": {
          "200": {
            "description": "RFC 8555 directory (resource URLs resolved from the request Host)",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": []
      }
    },
    "/acme/new-account": {
      "post": {
        "tags": [
          "acme"
        ],
        "summary": "`POST /acme/new-account`",
        "operationId": "new_account",
        "responses": {
          "201": {
            "description": "Account created/updated (JWS-verified)"
          },
          "400": {
            "description": "Malformed JWS"
          },
          "403": {
            "description": "Rejected identifier policy"
          }
        },
        "security": [],
        "description": "register a new ACME account (RFC 8555 §7.1.2),\npersisted to the accounts directory and announced as\n`sentin8:acme:account:created`."
      }
    },
    "/acme/new-order": {
      "post": {
        "tags": [
          "acme"
        ],
        "summary": "`POST /acme/new-order`",
        "description": "Mixed local/external identifiers are rejected; external orders are\nproxied to the upstream ACME provider when proxy mode is enabled,\notherwise the local CA issues them after challenge validation.\n\ncreate an order (RFC 8555 §7.1.3).",
        "operationId": "new_order",
        "responses": {
          "201": {
            "description": "Order created (authorizations + finalize URLs; locally-signed or relayed upstream)",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Unsupported/forbidden identifier"
          },
          "403": {
            "description": "Local-domain without proxy mode, or relay proxy off"
          }
        },
        "security": []
      }
    },
    "/acme/order/{id}": {
      "get": {
        "tags": [
          "acme"
        ],
        "summary": "`GET /acme/order/{id}`",
        "operationId": "get_order",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Order id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order status (pending → ready → valid)"
          },
          "404": {
            "description": "Unknown order"
          }
        },
        "security": [],
        "description": "fetch the order status."
      }
    },
    "/acme/order/{id}/finalize": {
      "post": {
        "tags": [
          "acme"
        ],
        "summary": "`POST /acme/order/{id}/finalize`",
        "operationId": "finalize_order",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Order id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order finalized (CSR processed; platform-CA or upstream-signed chain)"
          },
          "400": {
            "description": "Invalid CSR"
          },
          "404": {
            "description": "Unknown order"
          },
          "409": {
            "description": "Order not in ready state"
          }
        },
        "security": [],
        "description": "submit the CSR and issue the\ncertificate (RFC 8555 §7.4). Local orders require a VALID\nauthorization (defense in depth - the challenge short-circuit set it;\nan order that never proved control is never signed) and are signed\nby the Intermediate CA; external orders are finalized upstream\nthrough the relay and the certificate cached (DESIGN §4.2)."
      }
    },
    "/acme/revoke-cert": {
      "post": {
        "tags": [
          "acme"
        ],
        "summary": "`POST /acme/revoke-cert`",
        "operationId": "revoke_cert",
        "responses": {
          "200": {
            "description": "Certificate revoked (metadata flag / upstream relay)"
          },
          "400": {
            "description": "Malformed revocation request"
          }
        },
        "security": [],
        "description": "revoke a certificate (RFC 8555 §7.6),\nmarking its metadata and announcing `sentin8:acme:certificate:revoked`."
      }
    },
