    "/v1/consume/sse": {
      "get": {
        "tags": [
          "bus"
        ],
        "summary": "Long-lived SSE consume (server → client one-way) — the direct-consumer\ntransport (bus DESIGN §4.3): the client receives every stream message\nas an SSE event and ACKs via `POST /v1/ack`.",
        "operationId": "sse_handler",
        "parameters": [
          {
            "name": "stream_family",
            "in": "path",
            "description": "The stream family.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "consumer_group",
            "in": "path",
            "description": "The consumer group.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "consumer_name",
            "in": "path",
            "description": "The consumer name.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "token",
            "in": "path",
            "description": "The token.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE stream (event = ConsumeMessage JSON)",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "description": "Caller authentication failed (bearer / cert identity)"
          }
        },
        "security": [
          {
            "sentin8:bus:consume": []
          }
        ]
      }
    },
