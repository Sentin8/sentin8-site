    "/v1/internal/schedules/run": {
      "post": {
        "tags": [
          "secrets"
        ],
        "summary": "`POST /v1/internal/schedules/run`",
        "operationId": "secrets.internal.schedules.run",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {}
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Maintenance run completed"
          }
        },
        "description": "Sentin8:Cron proxy-back target.\nMaintenance sweeps that must not depend on a user request:\n(a) `expiry-scan` - emits `sentin8:secrets:secret:expiring` for every\nsecret whose `expires_at` lands within the next 14 days (secrets\nREADME §7), (b) `version-prune` - drops prunable non-current versions\nusing the service's own prune window (SECRETS-2, secrets DESIGN §10:\nthe schedule is declared at boot next to `expiry-scan`). Authenticated\nby the cron ticker's M2M token (verified like any other principal\nunder Shield)."
      }
    },
