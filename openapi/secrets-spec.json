  "components": {
    "schemas": {
      "AdminRotateRequest": {
        "type": "object",
        "description": "`POST /v1/admin/secrets/{name}/disable` - soft-disable (admin).\nRequest body for adminrotate.",
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The name."
          },
          "value": {
            "type": "string",
            "description": "The value."
          }
        }
      },
      "AdminUpsertRequest": {
        "type": "object",
        "description": "`POST /v1/admin/secrets` - store a secret from the admin form. Returns\nan RFW redirect to the secrets list. The value is encrypted server-side\nexactly like the public API (`put_secret`).\nRequest body for adminupsert.",
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "The description."
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Optional expiry - emits `sentin8:secrets:secret:expiring` T-14d\nbefore it via the cron schedule (secrets README §7)."
          },
          "name": {
            "type": "string",
            "description": "The name."
          },
          "value": {
            "type": "string",
            "description": "The value."
          }
        }
      },
      "ListSecretsQuery": {
        "type": "object",
        "description": "The listsecretsquery type.",
        "properties": {
          "status": {
            "type": [
              "string",
              "null"
            ],
            "description": "The status."
          }
        }
      },
      "ReEncryptRequest": {
        "type": "object",
        "description": "`POST /v1/secrets/maintenance/re-encrypt` - re-encrypt rows whose\n`key_version` is below the current master-key epoch (design\nrotation lever). Read old / write new per row; idempotent + resumable\n(rows keep their old `key_version` until successfully re-written).\nRequest body for reencrypt.",
        "required": [
          "previous_master_key"
        ],
        "properties": {
          "new_key_version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "New epoch to stamp on re-encrypted rows (defaults to 1).\nThe new key version."
          },
          "previous_master_key": {
            "type": "string",
            "description": "The PREVIOUS master key (base64-32) used to open `key_version < current` rows.\nThe previous master key."
          }
        }
      },
      "ResolveRequest": {
        "type": "object",
        "description": "`POST /v1/secrets/resolve` - machine resolution. Body:\n`{\"ref\": \"secrets://<name>\"}` → `{\"value\": ..., \"version\": ...}`.\nStandard consumption path for services; audit row per call.\nRequest body for resolve.",
        "required": [
          "ref"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "description": "Secret reference URI (`secrets://<name>`; a bare name is accepted)."
          }
        }
      },
      "ResolveResponse": {
        "type": "object",
        "description": "Response payload for resolve.",
        "required": [
          "name",
          "value",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The name."
          },
          "value": {
            "type": "string",
            "description": "The value."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "The version."
          }
        }
      },
      "TargetEnvQuery": {
        "type": "object",
        "description": "Resolve the effective env_id for admin operations.\nPriority: target_env_id query param (BFF proxy) > x-sentin8-env-id header (TLS) > token env_id.\nThe targetenvquery type.",
        "properties": {
          "target_env_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "UpsertSecretRequest": {
        "type": "object",
        "description": "`PUT /v1/secrets/{name}` - upsert + new version.\nRequest body for upsertsecret.",
        "required": [
          "value"
        ],
        "properties": {
          "description": {
            "type": "string",
            "description": "The description."
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Optional expiry - a Cron schedule emits `sentin8:secrets:secret:expiring`\nT-14d before it (secrets README §7)."
          },
          "value": {
            "type": "string",
            "description": "Plaintext secret value (encrypted server-side, never stored as sent).\nThe value."
          }
        }
      }
    }
