          "403": {
            "description": "Caller lacks a secrets read/admin scope"
          }
        },
        "security": [
          {
            "sentin8:secrets:read": []
          }
        ],
        "description": "GET alias for `/v1/admin/secrets` - the POST-only literal on the same\npath shadows the `/v1/admin/{resource}` catch-all for GET requests\n(axum returns 405 instead of falling through), so the data read must be\nregistered explicitly, mirroring the db service pattern."
      },
      "post": {
        "tags": [
          "admin-ui"
        ],
        "summary": "`POST /v1/admin/secrets`",
        "operationId": "admin_put_secret",
        "parameters": [
          {
            "name": "target_env_id",
            "in": "query",
            "description": "Target env (RLS context)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminUpsertRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Secret stored encrypted (RFW redirect to the list)",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "Caller lacks a secrets admin scope"
          }
        },
        "security": [
          {
            "sentin8:secrets:write": []
          }
        ],
        "description": "Handle admin put secret."
      }
    },
