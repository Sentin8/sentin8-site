    "/v1/admin/secrets": {
      "get": {
        "tags": [
          "admin-ui"
        ],
        "summary": "`GET /v1/admin/secrets`",
        "operationId": "get_admin_data_secrets",
        "parameters": [
          {
            "name": "target_env_id",
            "in": "query",
            "description": "Target env (RLS context)",
            "required": true,
            "schema": {
              "type": "string"
